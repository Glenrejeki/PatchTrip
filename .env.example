# --- Application Config ---
APP_NAME=PatchTrip
DEBUG=True
API_V1_STR=/api/v1

# --- Database Config (PostgreSQL) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=patchtrip_db
DATABASE_URL=

# --- AI Models & Vector Store Config ---
EMBEDDING_MODEL_PATH=BAAI/bge-m3
VECTOR_STORE_PATH=backend/data/vector_store
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# (Catatan: Sesuaikan nama model Qwen3-8B atau Qwen2.5 sesuai bobot lokal / API yang Anda gunakan nanti)

# --- Hugging Face / API Keys (Jika diperlukan untuk download model embedding/LLM) ---
HUGGINGFACE_HUB_TOKEN=your_huggingface_token_here